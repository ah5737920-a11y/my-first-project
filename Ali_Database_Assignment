-- TEESRA WALA - LEFT JOIN - SARE CUSTOMERS, ORDER HO YA NA HO
SELECT 
    C.CustomerID,
    C.FirstName,
    C.LastName,
    C.Country,
    C.City,
    O.OrderID,
    O.OrderDate,
    O.Amount,
    O.Status
FROM Customers C
LEFT JOIN Orders O ON C.CustomerID = O.CustomerID
ORDER BY C.FirstName ASC;
-- JOIN 1: INNER JOIN - Customers + Orders
SELECT C.FirstName, C.LastName, O.OrderID, O.Amount, O.Status
FROM Customers C
JOIN Orders O ON C.CustomerID = O.CustomerID;

-- JOIN 2: LEFT JOIN - Sare Customers
SELECT C.FirstName, C.LastName, O.OrderID, O.Amount, O.Status
FROM Customers C
LEFT JOIN Orders O ON C.CustomerID = O.CustomerID;
