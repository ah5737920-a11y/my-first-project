-- Q1: Total kitne rows hain?
SELECT COUNT(*) AS Total_Rows FROM Orders_50;

-- Q2: Har Customer ne kitne orders kiye? (Aapka wala screenshot)
SELECT Customer_Name, COUNT(*) AS Total_Orders, SUM(AMOUNT) AS Total_Paisa
FROM Orders_50
GROUP BY Customer_Name
ORDER BY Total_Orders DESC;
-- Q3: Kis City se sab se zyada paisa aaya?
SELECT City, SUM(AMOUNT) AS Total_Paisa
FROM Orders_50
GROUP BY City
ORDER BY Total_Paisa DESC;
